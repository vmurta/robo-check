#pragma once
#include "Utils.h"
#include "Triangle.hu"
#include "OBB-BVH-naive.hu"
#include <vector>

// Unit quaternion (x, y, z, w), used for the quaternion node-storage layout.
struct Quat {
    float x, y, z, w;
};

// Converts a unit quaternion to a 3x3 rotation matrix.
__host__ __device__ __forceinline__ Eigen::Matrix3f quatToMatrix(const Quat& q) {
    const float xx = q.x * q.x;
    const float yy = q.y * q.y;
    const float zz = q.z * q.z;
    const float xy = q.x * q.y;
    const float xz = q.x * q.z;
    const float yz = q.y * q.z;
    const float wx = q.w * q.x;
    const float wy = q.w * q.y;
    const float wz = q.w * q.z;

    Eigen::Matrix3f R;
    R(0, 0) = 1.0f - 2.0f * (yy + zz);
    R(0, 1) = 2.0f * (xy - wz);
    R(0, 2) = 2.0f * (xz + wy);
    R(1, 0) = 2.0f * (xy + wz);
    R(1, 1) = 1.0f - 2.0f * (xx + zz);
    R(1, 2) = 2.0f * (yz - wx);
    R(2, 0) = 2.0f * (xz - wy);
    R(2, 1) = 2.0f * (yz + wx);
    R(2, 2) = 1.0f - 2.0f * (xx + yy);
    return R;
}

// Hamilton-product helpers: qA*qB, conjugate, and vector rotation, matching
// the quatToMatrix convention above (R v == rotate(q, v) for unit q).
__host__ __device__ __forceinline__ Quat quatMul(const Quat& p, const Quat& q) {
    Quat r;
    r.w = p.w*q.w - p.x*q.x - p.y*q.y - p.z*q.z;
    r.x = p.w*q.x + p.x*q.w + p.y*q.z - p.z*q.y;
    r.y = p.w*q.y - p.x*q.z + p.y*q.w + p.z*q.x;
    r.z = p.w*q.z + p.x*q.y - p.y*q.x + p.z*q.w;
    return r;
}

__host__ __device__ __forceinline__ Quat quatConj(const Quat& q) {
    Quat r = {-q.x, -q.y, -q.z, q.w};
    return r;
}

// v' = q v q* (unit q). t = 2(r x v); v' = v + w t + r x t.
__host__ __device__ __forceinline__ Eigen::Vector3f quatRotateVec(const Quat& q, const Eigen::Vector3f& v) {
    const float tx = 2.0f * (q.y * v[2] - q.z * v[1]);
    const float ty = 2.0f * (q.z * v[0] - q.x * v[2]);
    const float tz = 2.0f * (q.x * v[1] - q.y * v[0]);
    return Eigen::Vector3f(v[0] + q.w * tx + (q.y * tz - q.z * ty),
                           v[1] + q.w * ty + (q.z * tx - q.x * tz),
                           v[2] + q.w * tz + (q.x * ty - q.y * tx));
}

// Matrix -> unit quaternion (Shepperd), same convention as quatToMatrix.
__host__ __device__ __forceinline__ Quat matrixToQuat(const Eigen::Matrix3f& R) {
    Quat q;
    const float t = R(0,0) + R(1,1) + R(2,2);
    if (t > 0.0f) {
        float s = sqrtf(t + 1.0f);
        q.w = 0.5f * s;
        s = 0.5f / s;
        q.x = (R(2,1) - R(1,2)) * s;
        q.y = (R(0,2) - R(2,0)) * s;
        q.z = (R(1,0) - R(0,1)) * s;
    } else if (R(0,0) > R(1,1) && R(0,0) > R(2,2)) {
        float s = sqrtf(1.0f + R(0,0) - R(1,1) - R(2,2));
        q.x = 0.5f * s;
        s = 0.5f / s;
        q.y = (R(1,0) + R(0,1)) * s;
        q.z = (R(0,2) + R(2,0)) * s;
        q.w = (R(2,1) - R(1,2)) * s;
    } else if (R(1,1) > R(2,2)) {
        float s = sqrtf(1.0f + R(1,1) - R(0,0) - R(2,2));
        q.y = 0.5f * s;
        s = 0.5f / s;
        q.x = (R(1,0) + R(0,1)) * s;
        q.z = (R(2,1) + R(1,2)) * s;
        q.w = (R(0,2) - R(2,0)) * s;
    } else {
        float s = sqrtf(1.0f + R(2,2) - R(0,0) - R(1,1));
        q.z = 0.5f * s;
        s = 0.5f / s;
        q.x = (R(0,2) + R(2,0)) * s;
        q.y = (R(2,1) + R(1,2)) * s;
        q.w = (R(1,0) - R(0,1)) * s;
    }
    return q;
}

// Pure-quaternion relative transform (broad phase only, no matrix materialized):
//   tw  = link_T + rotate(q_link, T_rob) - T_obs
//   T   = rotate(conj(q_obs), tw)                == R_obs^T * tw
//   qB  = conj(q_obs) * q_link * q_rob           (B == R_obs^T * R_link * R_rob)
__host__ __device__ __forceinline__ void computeRelTransformQuat(const Quat& q_obs, const Eigen::Vector3f& T_obs,
                                                                 const Quat& q_rob, const Eigen::Vector3f& T_rob,
                                                                 const Quat& q_link, const Eigen::Vector3f& link_T,
                                                                 Quat& qB, Eigen::Vector3f& T) {
    const Quat qw = quatMul(q_link, q_rob);
    const Quat qoc = quatConj(q_obs);
    const Eigen::Vector3f tw = link_T + quatRotateVec(q_link, T_rob) - T_obs;
    qB = quatMul(qoc, qw);
    T = quatRotateVec(qoc, tw);
}

// 15 OBB separating-axis tests with B entries evaluated directly from the
// quaternion components (no matrix materialized). Same eps folding as
// obbOverlapAbs. Entry formulas mirror quatToMatrix:
//   B00 = 1-2(yy+zz)  B01 = 2(xy-wz)  B02 = 2(xz+wy)
//   B10 = 2(xy+wz)    B11 = 1-2(xx+zz) B12 = 2(yz-wx)
//   B20 = 2(xz-wy)    B21 = 2(yz+wx)  B22 = 1-2(xx+yy)
__host__ __device__ __forceinline__ bool obbOverlapQuat(const Quat& q, const Eigen::Vector3f& T,
                                                        const Eigen::Vector3f& a, const Eigen::Vector3f& b,
                                                        const float eps) {
    const float qx = q.x, qy = q.y, qz = q.z, qw = q.w;
    const float xx = qx*qx, yy = qy*qy, zz = qz*qz;
    const float xy = qx*qy, xz = qx*qz, yz = qy*qz;
    const float wx = qw*qx, wy = qw*qy, wz = qw*qz;
    const float B00 = 1.0f - 2.0f*(yy + zz);
    const float B01 = 2.0f*(xy - wz);
    const float B02 = 2.0f*(xz + wy);
    const float B10 = 2.0f*(xy + wz);
    const float B11 = 1.0f - 2.0f*(xx + zz);
    const float B12 = 2.0f*(yz - wx);
    const float B20 = 2.0f*(xz - wy);
    const float B21 = 2.0f*(yz + wx);
    const float B22 = 1.0f - 2.0f*(xx + yy);

    const float aS = a[0] + a[1] + a[2];
    const float bS = b[0] + b[1] + b[2];
    const float ebs = eps * bS;
    const float eas = eps * aS;
    const float S = ebs + eas;
    const float a0e = a[0] + ebs;
    const float a1e = a[1] + ebs;
    const float a2e = a[2] + ebs;
    const float b0e = b[0] + eas;
    const float b1e = b[1] + eas;
    const float b2e = b[2] + eas;

    float t;

    t = fabsf(T[0]);
    if (t > (fabsf(B00)*b[0] + fabsf(B01)*b[1] + fabsf(B02)*b[2] + a0e)) return false;

    t = fabsf(B00*T[0] + B10*T[1] + B20*T[2]);
    if (t > (fabsf(B00)*a[0] + fabsf(B10)*a[1] + fabsf(B20)*a[2] + b0e)) return false;

    t = fabsf(T[1]);
    if (t > (fabsf(B10)*b[0] + fabsf(B11)*b[1] + fabsf(B12)*b[2] + a1e)) return false;

    t = fabsf(T[2]);
    if (t > (fabsf(B20)*b[0] + fabsf(B21)*b[1] + fabsf(B22)*b[2] + a2e)) return false;

    t = fabsf(B01*T[0] + B11*T[1] + B21*T[2]);
    if (t > (fabsf(B01)*a[0] + fabsf(B11)*a[1] + fabsf(B21)*a[2] + b1e)) return false;

    t = fabsf(B02*T[0] + B12*T[1] + B22*T[2]);
    if (t > (fabsf(B02)*a[0] + fabsf(B12)*a[1] + fabsf(B22)*a[2] + b2e)) return false;

    t = fabsf(T[2] * B10 - T[1] * B20);
    if (t > (fabsf(B20)*a[1] + fabsf(B10)*a[2] +
             fabsf(B02)*b[1] + fabsf(B01)*b[2] +
             (S - eps*(a[0] + b[0])))) return false;

    t = fabsf(T[2] * B11 - T[1] * B21);
    if (t > (fabsf(B21)*a[1] + fabsf(B11)*a[2] +
             fabsf(B02)*b[0] + fabsf(B00)*b[2] +
             (S - eps*(a[0] + b[1])))) return false;

    t = fabsf(T[2] * B12 - T[1] * B22);
    if (t > (fabsf(B22)*a[1] + fabsf(B12)*a[2] +
             fabsf(B01)*b[0] + fabsf(B00)*b[1] +
             (S - eps*(a[0] + b[2])))) return false;

    t = fabsf(T[0] * B20 - T[2] * B00);
    if (t > (fabsf(B20)*a[0] + fabsf(B00)*a[2] +
             fabsf(B12)*b[1] + fabsf(B11)*b[2] +
             (S - eps*(a[1] + b[0])))) return false;

    t = fabsf(T[0] * B21 - T[2] * B01);
    if (t > (fabsf(B21)*a[0] + fabsf(B01)*a[2] +
             fabsf(B12)*b[0] + fabsf(B10)*b[2] +
             (S - eps*(a[1] + b[1])))) return false;

    t = fabsf(T[0] * B22 - T[2] * B02);
    if (t > (fabsf(B22)*a[0] + fabsf(B02)*a[2] +
             fabsf(B11)*b[0] + fabsf(B10)*b[1] +
             (S - eps*(a[1] + b[2])))) return false;

    t = fabsf(T[1] * B00 - T[0] * B10);
    if (t > (fabsf(B10)*a[0] + fabsf(B00)*a[1] +
             fabsf(B22)*b[1] + fabsf(B21)*b[2] +
             (S - eps*(a[2] + b[0])))) return false;

    t = fabsf(T[1] * B01 - T[0] * B11);
    if (t > (fabsf(B11)*a[0] + fabsf(B01)*a[1] +
             fabsf(B22)*b[0] + fabsf(B20)*b[2] +
             (S - eps*(a[2] + b[1])))) return false;

    t = fabsf(T[1] * B02 - T[0] * B12);
    if (t > (fabsf(B12)*a[0] + fabsf(B02)*a[1] +
             fabsf(B21)*b[0] + fabsf(B20)*b[1] +
             (S - eps*(a[2] + b[2])))) return false;

    return true;
}

// A configuration for an articulated robot with N revolute joints.
// Mirrors the ROS2 convention where each entry is a single joint angle
// (radians), one per joint in the serial chain.
template <size_t N>
struct articulated_conf {
    float joints[N];

    __host__ __device__ articulated_conf() {
        for (size_t i = 0; i < N; ++i) {
            joints[i] = 0.0f;
        }
    }

    __host__ __device__ float& operator[](size_t i) { return joints[i]; }
    __host__ __device__ const float& operator[](size_t i) const { return joints[i]; }
};

// Fixed (non-angle) data for a single revolute joint in a serial chain.
// Joint i connects parent link i to child link i + 1.
struct JointParams {
    Eigen::Matrix3f origin_R; // fixed rotation from parent frame to child frame (URDF <origin> rpy)
    Eigen::Vector3f origin_T; // fixed translation from parent frame to child frame (URDF <origin> xyz)
    Eigen::Vector3f axis;     // rotation axis expressed in the child frame (URDF <axis> xyz)
};

// Host-side description of an articulated robot parsed from a URDF file.
struct ArticulatedRobot {
    size_t num_joints = 0;
    std::vector<JointParams> joints;        // size num_joints
    std::vector<std::string> link_names;    // size num_joints + 1
    std::vector<std::string> link_meshes;   // size num_joints + 1 (empty if no collision mesh)
};

// Parses a ROS2 URDF file assuming a serial chain of revolute joints.
// Returns false and prints an error if the file cannot be parsed or the
// joint structure is not a linear chain.
bool parseSerialChainURDF(const std::string& urdf_path, ArticulatedRobot& robot);

// Reads an articulated configuration file: one configuration per line,
// each line containing N whitespace-separated joint angles in radians.
template <size_t N>
void readArticulatedConfigurationFromFile(const std::string& filename, std::vector<articulated_conf<N>>& confs);

// Forward kinematics for a serial chain: computes the world rotation and
// translation of every link (link_R/link_T have num_joints + 1 entries).
// The base link is fixed at the world origin.
template <size_t N>
__host__ __device__ void forwardKinematics(const articulated_conf<N>& conf,
                                           const JointParams* joints,
                                           Eigen::Matrix3f* link_R,
                                           Eigen::Vector3f* link_T);

// Rotation matrix from an axis and an angle (Rodrigues formula).
__host__ __device__ inline Eigen::Matrix3f axisAngleToRotation(const Eigen::Vector3f& axis, float angle) {
    float n = sqrtf(axis[0] * axis[0] + axis[1] * axis[1] + axis[2] * axis[2]);
    float ax = axis[0] / n;
    float ay = axis[1] / n;
    float az = axis[2] / n;

    float c = cosf(angle);
    float s = sinf(angle);
    float t = 1.0f - c;

    Eigen::Matrix3f R;
    R(0, 0) = c + ax * ax * t;
    R(0, 1) = ax * ay * t - az * s;
    R(0, 2) = ax * az * t + ay * s;
    R(1, 0) = ay * ax * t + az * s;
    R(1, 1) = c + ay * ay * t;
    R(1, 2) = ay * az * t - ax * s;
    R(2, 0) = az * ax * t - ay * s;
    R(2, 1) = az * ay * t + ax * s;
    R(2, 2) = c + az * az * t;
    return R;
}

// ---------------------------------------------------------------------------
// Kernel variants for the A/B/C/BC experiment:
//   RESTRICT_PTRS = false -> plain pointers (baseline codegen)
//   RESTRICT_PTRS = true  -> const __restrict__ pointers (lets ptxas emit
//                            LDG.E.CONSTANT / vectorized loads)
//   RobChildT/ObsChildT = int32_t (baseline) or int16_t (halves first_child
//                            loads and the pend/tri queue element size per
//                            side; usable per side only when that side's node
//                            count fits in 15 bits)
// ---------------------------------------------------------------------------
template <size_t N, typename RobChildT, typename ObsChildT, bool RESTRICT_PTRS>
struct ArticKernelPtrs;

template <size_t N, typename RobChildT, typename ObsChildT>
struct ArticKernelPtrs<N, RobChildT, ObsChildT, false> {
    typedef const Eigen::Matrix3f* RM;
    typedef const Eigen::Vector3f* V3;
    typedef const ObsChildT* ObsChild;
    typedef const RobChildT* RobChild;
    typedef const float* FP;
    typedef const Triangle* TP;
    typedef const int* IP;
    typedef const JointParams* JP;
    typedef const articulated_conf<N>* CP;
};

template <size_t N, typename RobChildT, typename ObsChildT>
struct ArticKernelPtrs<N, RobChildT, ObsChildT, true> {
    typedef const Eigen::Matrix3f* __restrict__ RM;
    typedef const Eigen::Vector3f* __restrict__ V3;
    typedef const ObsChildT* __restrict__ ObsChild;
    typedef const RobChildT* __restrict__ RobChild;
    typedef const float* __restrict__ FP;
    typedef const Triangle* __restrict__ TP;
    typedef const int* __restrict__ IP;
    typedef const JointParams* __restrict__ JP;
    typedef const articulated_conf<N>* __restrict__ CP;
};

// Queue element type for the pending/tri buffers: uint16 when child indices
// are int16 (halves the static shared-memory footprint on that side).
template <typename ChildT>
struct ArticQueueIdx;
template <>
struct ArticQueueIdx<int16_t> {
    typedef uint16_t Q;
};
template <>
struct ArticQueueIdx<int32_t> {
    typedef uint32_t Q;
};

// ---------------------------------------------------------------------------
// Node-data layouts (experiment): how each BVH node's R/T/dim/a is stored on
// the device. Only the pointers belonging to the kernel's LAYOUT are non-null.
// ---------------------------------------------------------------------------
enum class NodeLayout : int {
    Matrix = 0,  // Eigen::Matrix3f/Vector3f SoA arrays (baseline, scalar LDG.E)
    Quat   = 1,  // R as quaternion float4 (1x LDG.128 per node, quat->matrix in-kernel)
    VecR   = 2,  // R as 3x float4 rows (16B-aligned, 3x LDG.128 per node)
    QuatTD = 3,  // R as quaternion + T/dim/a packed in 2x float4 (3x LDG.128 per node)
    QuatSAT = 4, // QuatTD storage but PURE-QUATERNION broad phase: the quaternion
                 // is never converted to a matrix in the traversal; the 15 SAT
                 // B entries are evaluated from quaternion components.
};
struct NodePtrs {
    const Eigen::Matrix3f* R; // layout 0
    const float4* Rq;         // layouts 1, 3, 4 (x,y,z,w)
    const float4* Rp;         // layout 2 (3x float4 rows per node)
    const float4* TD;         // layouts 3, 4: (T.xyz,dim.x),(dim.yz,a,pad)
    const Eigen::Vector3f* T; // layouts 0-2
    const Eigen::Vector3f* dim; // layouts 0-2
    const float* a;           // layouts 0-2
};

// Loads one node's (R, T, dim, a) into registers. LAYOUT is a template
// constant, so the dead branches fold away per instantiation.
template <NodeLayout LAYOUT>
__device__ __forceinline__ void loadNode(const NodePtrs& p, int i,
                                         Eigen::Matrix3f& R, Eigen::Vector3f& T,
                                         Eigen::Vector3f& dim, float& a) {
    if (LAYOUT == NodeLayout::Matrix) {
        R = p.R[i];
        T = p.T[i];
        dim = p.dim[i];
        a = p.a[i];
    } else if (LAYOUT == NodeLayout::Quat) {
        const float4 q = p.Rq[i];
        R = quatToMatrix(Quat{q.x, q.y, q.z, q.w});
        T = p.T[i];
        dim = p.dim[i];
        a = p.a[i];
    } else if (LAYOUT == NodeLayout::VecR) {
        const float4 r0 = p.Rp[i * 3 + 0];
        const float4 r1 = p.Rp[i * 3 + 1];
        const float4 r2 = p.Rp[i * 3 + 2];
        R(0, 0) = r0.x;
        R(0, 1) = r0.y;
        R(0, 2) = r0.z;
        R(1, 0) = r1.x;
        R(1, 1) = r1.y;
        R(1, 2) = r1.z;
        R(2, 0) = r2.x;
        R(2, 1) = r2.y;
        R(2, 2) = r2.z;
        T = p.T[i];
        dim = p.dim[i];
        a = p.a[i];
    } else {
        const float4 q = p.Rq[i];
        const float4 t0 = p.TD[i * 2 + 0];
        const float4 t1 = p.TD[i * 2 + 1];
        R = quatToMatrix(Quat{q.x, q.y, q.z, q.w});
        T = Eigen::Vector3f(t0.x, t0.y, t0.z);
        dim = Eigen::Vector3f(t0.w, t1.x, t1.y);
        a = t1.z;
    }
}

// Loads one node's (quat, T, dim, a) WITHOUT converting the quaternion to a
// matrix (NodeLayout::Quat = separate SoA arrays, QuatTD/QuatSAT = packed
// TD float4s). Used by the pure-quaternion broad phase.
template <NodeLayout LAYOUT>
__device__ __forceinline__ void loadNodeQuat(const NodePtrs& p, int i,
                                             Quat& q, Eigen::Vector3f& T,
                                             Eigen::Vector3f& dim, float& a) {
    if (LAYOUT == NodeLayout::Quat) {
        const float4 qq = p.Rq[i];
        q = Quat{qq.x, qq.y, qq.z, qq.w};
        T = p.T[i];
        dim = p.dim[i];
        a = p.a[i];
    } else {
        const float4 qq = p.Rq[i];
        const float4 t0 = p.TD[i * 2 + 0];
        const float4 t1 = p.TD[i * 2 + 1];
        q = Quat{qq.x, qq.y, qq.z, qq.w};
        T = Eigen::Vector3f(t0.x, t0.y, t0.z);
        dim = Eigen::Vector3f(t0.w, t1.x, t1.y);
        a = t1.z;
    }
}

// SoA parameter bundles for d_bvh_articulated: one struct per side plus the
// result/queue/counter struct. Struct params are copied into the kernel
// parameter space exactly like the equivalent flat parameter list, so this
// costs nothing and keeps the (large) kernel call readable.
template <typename ChildT>
struct ObstacleSoA {
    NodePtrs nodes;                  // node data for the selected LAYOUT
    const ChildT* first_child;
    size_t num_nodes;
    const Eigen::Vector3f* verts;
    const Triangle* tris;
};

template <typename ChildT>
struct RobotSoA {
    NodePtrs nodes;                  // node data for the selected LAYOUT
    const ChildT* first_child;
    const int* linkOffset;           // per-link partition of the concatenated BVH
    const int* linkVertOffset;
    const int* linkTriOffset;
    const JointParams* joints;
    const Eigen::Vector3f* verts;
    const Triangle* tris;
};

struct KernelOut {
    uint32_t* pdisjoint;             // bitpacked results (1 = disjoint/free)
    uint32_t* g_next_conf;           // global config work queue
    unsigned long long* overflowCounter;
};

// d_bvh_articulated: articulated version of d_bvh_naive with the same
// persistent-block / block-serial traversal strategy. Results are bit-packed
// in out.pdisjoint (1 = disjoint/free). out.overflowCounter counts
// conservative pending-list overflows (must stay 0).
//
// Variants:
//   RobChildT/ObsChildT = int16_t shrinks child loads/queues per side
//   RESTRICT_PTRS=true  adds __restrict__ pointers
//   LAYOUT              selects the node-data storage layout (see NodeLayout)
template <size_t N, typename RobChildT = int32_t, typename ObsChildT = int32_t,
          bool RESTRICT_PTRS = false, NodeLayout LAYOUT = NodeLayout::Matrix>
__global__ void d_bvh_articulated(const ObstacleSoA<ObsChildT> obs,
                                  const RobotSoA<RobChildT> rob,
                                  const articulated_conf<N>* pConf, size_t num_confs,
                                  const KernelOut out);

// Host wrapper mirroring bvh_naive. Builds per-link BVHs from the URDF,
// allocates device memory, launches d_bvh_articulated<N>, and copies results.
//
// kernel_mode selects the variant:
//   bit 0  = int16 child indices (where they fit)
//   bit 1  = __restrict__ pointers
//   bits 2-3 = node-data layout (0-3, see NodePtrs)
// int16 silently falls back to int32 when any node index exceeds 15 bits.
template <size_t N>
double bvh_articulated(const std::string& robot_urdf_path,
                       const BVNode_soa<int32_t>& obs_BVH, const MeshData& obs_mesh,
