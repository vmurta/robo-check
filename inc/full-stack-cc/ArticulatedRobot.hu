#pragma once
#include "Utils.h"
#include "Triangle.hu"
#include "OBB-BVH-naive.hu"
#include <vector>

// A configuration for an articulated robot with N revolute joints.
// Mirrors the ROS2 convention where each entry is a single joint angle
// (radians), one per joint in the serial chain.
template <size_t N>
struct articulated_conf {
    float joints[N];

    __host__ __device__ articulated_conf() {
        for (size_t i = 0; i < N; ++i) {
            joints[i] = 0.0f;
        }
    }

    __host__ __device__ float& operator[](size_t i) { return joints[i]; }
    __host__ __device__ const float& operator[](size_t i) const { return joints[i]; }
};

// Fixed (non-angle) data for a single revolute joint in a serial chain.
// Joint i connects parent link i to child link i + 1.
struct JointParams {
    Eigen::Matrix3f origin_R; // fixed rotation from parent frame to child frame (URDF <origin> rpy)
    Eigen::Vector3f origin_T; // fixed translation from parent frame to child frame (URDF <origin> xyz)
    Eigen::Vector3f axis;     // rotation axis expressed in the child frame (URDF <axis> xyz)
};

// Matrix-free joint data for the QuatSAT layout: the fixed <origin> rotation
// and the axis are folded into two precomputed quats (no Eigen matrix in
// global memory). The per-link joint rotation is the shallow linear combine
//   q_joint(theta) = origin_Q * axisAngleToQuat(axis, theta)
//                  = cos(theta/2) * A + sin(theta/2) * B
// with A = origin_Q and B = quatMul(origin_Q, (axis.x, axis.y, axis.z, 0)).
// The kernel uses q_joint both as an incremental link quaternion (pure-quat
// broad phase) and, via quatToMatrix, as the joint rotation matrix for the
// matrix FK advance (one 3x3 product per link, no Rodrigues).
struct JointParamsQuat {
    Quat A;                  // unit quaternion of the fixed <origin> rotation
    Quat B;                  // origin_Q * pure-axis quaternion
    Eigen::Vector3f origin_T; // fixed translation from parent frame to child frame
};

// Host-side description of an articulated robot parsed from a URDF file.
struct ArticulatedRobot {
    size_t num_joints = 0;
    std::vector<JointParams> joints;        // size num_joints
    std::vector<std::string> link_names;    // size num_joints + 1
    std::vector<std::string> link_meshes;   // size num_joints + 1 (empty if no collision mesh)
};

// Parses a ROS2 URDF file assuming a serial chain of revolute joints.
// Returns false and prints an error if the file cannot be parsed or the
// joint structure is not a linear chain.
bool parseSerialChainURDF(const std::string& urdf_path, ArticulatedRobot& robot);

// Reads an articulated configuration file: one configuration per line,
// each line containing N whitespace-separated joint angles in radians.
template <size_t N>
void readArticulatedConfigurationFromFile(const std::string& filename, std::vector<articulated_conf<N>>& confs);

// Forward kinematics for a serial chain: computes the world rotation and
// translation of every link (link_R/link_T have num_joints + 1 entries).
// The base link is fixed at the world origin.
template <size_t N>
__host__ __device__ void forwardKinematics(const articulated_conf<N>& conf,
                                           const JointParams* joints,
                                           Eigen::Matrix3f* link_R,
                                           Eigen::Vector3f* link_T);

// Rotation matrix from an axis and an angle (Rodrigues formula).
__host__ __device__ inline Eigen::Matrix3f axisAngleToRotation(const Eigen::Vector3f& axis, float angle) {
    float n = sqrtf(axis[0] * axis[0] + axis[1] * axis[1] + axis[2] * axis[2]);
    float ax = axis[0] / n;
    float ay = axis[1] / n;
    float az = axis[2] / n;

    float c = cosf(angle);
    float s = sinf(angle);
    float t = 1.0f - c;

    Eigen::Matrix3f R;
    R(0, 0) = c + ax * ax * t;
    R(0, 1) = ax * ay * t - az * s;
    R(0, 2) = ax * az * t + ay * s;
    R(1, 0) = ay * ax * t + az * s;
    R(1, 1) = c + ay * ay * t;
    R(1, 2) = ay * az * t - ax * s;
    R(2, 0) = az * ax * t - ay * s;
    R(2, 1) = az * ay * t + ax * s;
    R(2, 2) = c + az * az * t;
    return R;
}

// Unit quaternion from an axis and an angle (half-angle form). Matches
// axisAngleToRotation: quatToMatrix(axisAngleToQuat(a, t)) ==
// axisAngleToRotation(a, t) up to rounding.
__host__ __device__ inline Quat axisAngleToQuat(const Eigen::Vector3f& axis, float angle) {
    float n = sqrtf(axis[0] * axis[0] + axis[1] * axis[1] + axis[2] * axis[2]);
    const float s = sinf(0.5f * angle) / n;
    Quat q;
    q.x = axis[0] * s;
    q.y = axis[1] * s;
    q.z = axis[2] * s;
    q.w = cosf(0.5f * angle);
    return q;
}

// ---------------------------------------------------------------------------
// Kernel variants for the A/B/C/BC experiment:
//   RESTRICT_PTRS = false -> plain pointers (baseline codegen)
//   RESTRICT_PTRS = true  -> const __restrict__ pointers (lets ptxas emit
//                            LDG.E.CONSTANT / vectorized loads)
//   RobChildT/ObsChildT = int32_t (baseline) or int16_t (halves first_child
//                            loads and the pend/tri queue element size per
//                            side; usable per side only when that side's node
//                            count fits in 15 bits)
// ---------------------------------------------------------------------------
template <size_t N, typename RobChildT, typename ObsChildT, bool RESTRICT_PTRS>
struct ArticKernelPtrs;

template <size_t N, typename RobChildT, typename ObsChildT>
struct ArticKernelPtrs<N, RobChildT, ObsChildT, false> {
    typedef const Eigen::Matrix3f* RM;
    typedef const Eigen::Vector3f* V3;
    typedef const ObsChildT* ObsChild;
    typedef const RobChildT* RobChild;
    typedef const float* FP;
    typedef const Triangle* TP;
    typedef const int* IP;
    typedef const JointParams* JP;
    typedef const articulated_conf<N>* CP;
};

template <size_t N, typename RobChildT, typename ObsChildT>
struct ArticKernelPtrs<N, RobChildT, ObsChildT, true> {
    typedef const Eigen::Matrix3f* __restrict__ RM;
    typedef const Eigen::Vector3f* __restrict__ V3;
    typedef const ObsChildT* __restrict__ ObsChild;
    typedef const RobChildT* __restrict__ RobChild;
    typedef const float* __restrict__ FP;
    typedef const Triangle* __restrict__ TP;
    typedef const int* __restrict__ IP;
    typedef const JointParams* __restrict__ JP;
    typedef const articulated_conf<N>* __restrict__ CP;
};

// Queue element type for the pending/tri buffers: uint16 when child indices
// are int16 (halves the static shared-memory footprint on that side).
template <typename ChildT>
struct ArticQueueIdx;
template <>
struct ArticQueueIdx<int16_t> {
    typedef uint16_t Q;
};
template <>
struct ArticQueueIdx<int32_t> {
    typedef uint32_t Q;
};

// ---------------------------------------------------------------------------
// Node-data layouts (experiment): how each BVH node's R/T/dim/a is stored on
// the device. Only the pointers belonging to the kernel's LAYOUT are non-null.
// ---------------------------------------------------------------------------
enum class NodeLayout : int {
    Matrix = 0,  // Eigen::Matrix3f/Vector3f SoA arrays (baseline, scalar LDG.E)
    Quat   = 1,  // R as quaternion float4 (1x LDG.128 per node, quat->matrix in-kernel)
    VecR   = 2,  // R as 3x float4 rows (16B-aligned, 3x LDG.128 per node)
    QuatTD = 3,  // R as quaternion + T/dim/a packed in 2x float4 (3x LDG.128 per node)
    QuatSAT = 4, // QuatTD storage but PURE-QUATERNION broad phase: the quaternion
                 // is never converted to a matrix in the traversal; the 15 SAT
                 // B entries are evaluated from quaternion components.
};
// Per-layout node-data pointer bundles: each specialization holds exactly
// the pointers its layout uses (no nulls, no unused fields). The loadNode /
// loadNodeQuat overloads dispatch on the bundle type, so call sites need no
// layout template argument.
template <NodeLayout L>
struct NodePtrsFor;

template <>
struct NodePtrsFor<NodeLayout::Matrix> {
    const Eigen::Matrix3f* R;
    const Eigen::Vector3f* T;
    const Eigen::Vector3f* dim;
    const float* a;
};

template <>
struct NodePtrsFor<NodeLayout::Quat> {
    const float4* Rq; // unit quaternion x,y,z,w
    const Eigen::Vector3f* T;
    const Eigen::Vector3f* dim;
    const float* a;
};

template <>
struct NodePtrsFor<NodeLayout::VecR> {
    const float4* Rp; // 3x float4 rows per node (16B-aligned)
    const Eigen::Vector3f* T;
    const Eigen::Vector3f* dim;
    const float* a;
};

template <>
struct NodePtrsFor<NodeLayout::QuatTD> {
    const float4* Rq; // unit quaternion x,y,z,w
    const float4* TD; // (T.xyz, dim.x) + (dim.yz, a, pad)
};

// QuatSAT uses exactly the QuatTD storage; sharing the bundle keeps the
// loadNode/loadNodeQuat overload set identical for both layouts.
template <>
struct NodePtrsFor<NodeLayout::QuatSAT> : NodePtrsFor<NodeLayout::QuatTD> {};

// Load one node's (R, T, dim, a) as a rotation MATRIX (matrix layouts, or the
// narrow phase). Overloads dispatch on the bundle type.
__device__ __forceinline__ void loadNode(const NodePtrsFor<NodeLayout::Matrix>& p, int i,
                                         Eigen::Matrix3f& R, Eigen::Vector3f& T,
                                         Eigen::Vector3f& dim, float& a) {
    R = p.R[i];
    T = p.T[i];
    dim = p.dim[i];
    a = p.a[i];
}

__device__ __forceinline__ void loadNode(const NodePtrsFor<NodeLayout::Quat>& p, int i,
                                         Eigen::Matrix3f& R, Eigen::Vector3f& T,
                                         Eigen::Vector3f& dim, float& a) {
    const float4 q = p.Rq[i];
    R = quatToMatrix(Quat{q.x, q.y, q.z, q.w});
    T = p.T[i];
    dim = p.dim[i];
    a = p.a[i];
}

__device__ __forceinline__ void loadNode(const NodePtrsFor<NodeLayout::VecR>& p, int i,
                                         Eigen::Matrix3f& R, Eigen::Vector3f& T,
                                         Eigen::Vector3f& dim, float& a) {
    const float4 r0 = p.Rp[i * 3 + 0];
    const float4 r1 = p.Rp[i * 3 + 1];
    const float4 r2 = p.Rp[i * 3 + 2];
    R(0, 0) = r0.x;
    R(0, 1) = r0.y;
    R(0, 2) = r0.z;
    R(1, 0) = r1.x;
    R(1, 1) = r1.y;
    R(1, 2) = r1.z;
    R(2, 0) = r2.x;
    R(2, 1) = r2.y;
    R(2, 2) = r2.z;
    T = p.T[i];
    dim = p.dim[i];
    a = p.a[i];
}

__device__ __forceinline__ void loadNode(const NodePtrsFor<NodeLayout::QuatTD>& p, int i,
                                         Eigen::Matrix3f& R, Eigen::Vector3f& T,
                                         Eigen::Vector3f& dim, float& a) {
    const float4 q = p.Rq[i];
    const float4 t0 = p.TD[i * 2 + 0];
    const float4 t1 = p.TD[i * 2 + 1];
    R = quatToMatrix(Quat{q.x, q.y, q.z, q.w});
    T = Eigen::Vector3f(t0.x, t0.y, t0.z);
    dim = Eigen::Vector3f(t0.w, t1.x, t1.y);
    a = t1.z;
}

// Load one node's (quat, T, dim, a) WITHOUT matrix conversion (pure-quat
// broad phase). QuatSAT uses the QuatTD bundle (identical storage). The
// Matrix/VecR overloads exist only so the QuatSAT branch compiles for every
// LAYOUT instantiation; they are never executed there.
__device__ __forceinline__ void loadNodeQuat(const NodePtrsFor<NodeLayout::Matrix>& p, int i,
                                             Quat& q, Eigen::Vector3f& T,
                                             Eigen::Vector3f& dim, float& a) {
    q = matrixToQuat(p.R[i]);
    T = p.T[i];
    dim = p.dim[i];
    a = p.a[i];
}

__device__ __forceinline__ void loadNodeQuat(const NodePtrsFor<NodeLayout::VecR>& p, int i,
                                             Quat& q, Eigen::Vector3f& T,
                                             Eigen::Vector3f& dim, float& a) {
    const float4 r0 = p.Rp[i * 3 + 0];
    const float4 r1 = p.Rp[i * 3 + 1];
    const float4 r2 = p.Rp[i * 3 + 2];
    Eigen::Matrix3f R;
    R(0, 0) = r0.x; R(0, 1) = r0.y; R(0, 2) = r0.z;
    R(1, 0) = r1.x; R(1, 1) = r1.y; R(1, 2) = r1.z;
    R(2, 0) = r2.x; R(2, 1) = r2.y; R(2, 2) = r2.z;
    q = matrixToQuat(R);
    T = p.T[i];
    dim = p.dim[i];
    a = p.a[i];
}

__device__ __forceinline__ void loadNodeQuat(const NodePtrsFor<NodeLayout::Quat>& p, int i,
                                             Quat& q, Eigen::Vector3f& T,
                                             Eigen::Vector3f& dim, float& a) {
    const float4 qq = p.Rq[i];
    q = Quat{qq.x, qq.y, qq.z, qq.w};
    T = p.T[i];
    dim = p.dim[i];
    a = p.a[i];
}

__device__ __forceinline__ void loadNodeQuat(const NodePtrsFor<NodeLayout::QuatTD>& p, int i,
                                             Quat& q, Eigen::Vector3f& T,
                                             Eigen::Vector3f& dim, float& a) {
    const float4 qq = p.Rq[i];
    const float4 t0 = p.TD[i * 2 + 0];
    const float4 t1 = p.TD[i * 2 + 1];
    q = Quat{qq.x, qq.y, qq.z, qq.w};
    T = Eigen::Vector3f(t0.x, t0.y, t0.z);
    dim = Eigen::Vector3f(t0.w, t1.x, t1.y);
    a = t1.z;
}

// SoA parameter bundles for d_bvh_articulated: one struct per side plus the
// result/queue/counter struct. Struct params are copied into the kernel
// parameter space exactly like the equivalent flat parameter list, so this
// costs nothing and keeps the (large) kernel call readable.
template <typename ChildT, NodeLayout L>
struct ObstacleSoA {
    NodePtrsFor<L> nodes;
    const ChildT* first_child;
    size_t num_nodes;
    NodePtrsFor<L> gate_nodes;       // parallel-phase gate list (same packing as nodes)
    int gate_count;                  // 1 = obs root only (default)
    const Eigen::Vector3f* verts;
    const Triangle* tris;
};

template <typename ChildT, NodeLayout L>
struct RobotSoA {
    NodePtrsFor<L> nodes;
    const ChildT* first_child;
    const int* linkOffset;           // per-link partition of the concatenated BVH
    const int* linkVertOffset;
    const int* linkTriOffset;
    const JointParams* joints;       // matrix-form joint data (all layouts)
    const JointParamsQuat* jointsQ;  // matrix-free joint data (QuatSAT only, null otherwise)
    const Eigen::Vector3f* verts;
    const Triangle* tris;
};

struct KernelOut {
    uint32_t* pdisjoint;             // bitpacked results (1 = disjoint/free)
    uint32_t* g_next_conf;           // global config work queue
    unsigned long long* overflowCounter;
};

// d_bvh_articulated: articulated version of d_bvh_naive with the same
// persistent-block / block-serial traversal strategy. Results are bit-packed
// in out.pdisjoint (1 = disjoint/free). out.overflowCounter counts
// conservative pending-list overflows (must stay 0).
//
// Variants:
//   RobChildT/ObsChildT = int16_t shrinks child loads/queues per side
//   RESTRICT_PTRS=true  adds __restrict__ pointers
//   LAYOUT              selects the node-data storage layout (see NodeLayout)
template <size_t N, typename RobChildT = int32_t, typename ObsChildT = int32_t,
          bool RESTRICT_PTRS = false, NodeLayout LAYOUT = NodeLayout::Matrix>
__global__ void d_bvh_articulated(const ObstacleSoA<ObsChildT, LAYOUT> obs,
                                  const RobotSoA<RobChildT, LAYOUT> rob,
                                  const articulated_conf<N>* pConf, size_t num_confs,
                                  const KernelOut out);

// Host wrapper mirroring bvh_naive. Builds per-link BVHs from the URDF,
// allocates device memory, launches d_bvh_articulated<N>, and copies results.
//
// kernel_mode selects the variant:
//   bit 0  = int16 child indices (where they fit)
//   bit 1  = __restrict__ pointers
//   bits 2-3 = node-data layout (0-3, see NodePtrs)
// int16 silently falls back to int32 when any node index exceeds 15 bits.
//
// The optional gate_R/gate_T/gate_dim vectors override the parallel-phase
// gate (default: the obs root OBB only). A link is gated iff its root OBB
// overlaps >=1 gate node; links that overlap none are provably collision-free
// and skip the serial traversal (the caller must ensure the gate covers every
// scene primitive, e.g. a BVH cut at level k or per-obstacle roots).
template <size_t N>
double bvh_articulated(const std::string& robot_urdf_path,
                       const BVNode_soa<int32_t>& obs_BVH, const MeshData& obs_mesh,
                       const std::vector<articulated_conf<N>>& confs,
                       std::vector<bool>& valid, bool dry_run = false,
                       int kernel_mode = 0,
                       const std::vector<Eigen::Matrix3f>* gate_R = nullptr,
                       const std::vector<Eigen::Vector3f>* gate_T = nullptr,
                       const std::vector<Eigen::Vector3f>* gate_dim = nullptr);

#include "ArticulatedRobot.tcc"
