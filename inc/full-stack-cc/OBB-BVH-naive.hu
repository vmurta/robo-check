#pragma once
#include "Utils.h"
#include "Triangle.hu"
#include <vector>

// ---------------------------------------------------------------------------
// Unit-quaternion math shared by the rigid, articulated, and edge kernels:
// Hamilton-product helpers, matrix<->quat conversion, and the pure-quaternion
// relative transform + 15-axis SAT test (quatSAT: no matrix materialization
// in the hot loop).
// ---------------------------------------------------------------------------
// Unit quaternion (x, y, z, w), used for the quaternion node-storage layout.
struct Quat {
    float x, y, z, w;
};

// Converts a unit quaternion to a 3x3 rotation matrix.
__host__ __device__ __forceinline__ Eigen::Matrix3f quatToMatrix(const Quat& q) {
    const float xx = q.x * q.x;
    const float yy = q.y * q.y;
    const float zz = q.z * q.z;
    const float xy = q.x * q.y;
    const float xz = q.x * q.z;
    const float yz = q.y * q.z;
    const float wx = q.w * q.x;
    const float wy = q.w * q.y;
    const float wz = q.w * q.z;

    Eigen::Matrix3f R;
    R(0, 0) = 1.0f - 2.0f * (yy + zz);
    R(0, 1) = 2.0f * (xy - wz);
    R(0, 2) = 2.0f * (xz + wy);
    R(1, 0) = 2.0f * (xy + wz);
    R(1, 1) = 1.0f - 2.0f * (xx + zz);
    R(1, 2) = 2.0f * (yz - wx);
    R(2, 0) = 2.0f * (xz - wy);
    R(2, 1) = 2.0f * (yz + wx);
    R(2, 2) = 1.0f - 2.0f * (xx + yy);
    return R;
}

// Hamilton-product helpers: qA*qB, conjugate, and vector rotation, matching
// the quatToMatrix convention above (R v == rotate(q, v) for unit q).
__host__ __device__ __forceinline__ Quat quatMul(const Quat& p, const Quat& q) {
    Quat r;
    r.w = p.w*q.w - p.x*q.x - p.y*q.y - p.z*q.z;
    r.x = p.w*q.x + p.x*q.w + p.y*q.z - p.z*q.y;
    r.y = p.w*q.y - p.x*q.z + p.y*q.w + p.z*q.x;
    r.z = p.w*q.z + p.x*q.y - p.y*q.x + p.z*q.w;
    return r;
}

__host__ __device__ __forceinline__ Quat quatConj(const Quat& q) {
    Quat r = {-q.x, -q.y, -q.z, q.w};
    return r;
}

// v' = q v q* (unit q). t = 2(r x v); v' = v + w t + r x t.
__host__ __device__ __forceinline__ Eigen::Vector3f quatRotateVec(const Quat& q, const Eigen::Vector3f& v) {
    const float tx = 2.0f * (q.y * v[2] - q.z * v[1]);
    const float ty = 2.0f * (q.z * v[0] - q.x * v[2]);
    const float tz = 2.0f * (q.x * v[1] - q.y * v[0]);
    return Eigen::Vector3f(v[0] + q.w * tx + (q.y * tz - q.z * ty),
                           v[1] + q.w * ty + (q.z * tx - q.x * tz),
                           v[2] + q.w * tz + (q.x * ty - q.y * tx));
}

// Matrix -> unit quaternion (Shepperd), same convention as quatToMatrix.
__host__ __device__ __forceinline__ Quat matrixToQuat(const Eigen::Matrix3f& R) {
    Quat q;
    const float t = R(0,0) + R(1,1) + R(2,2);
    if (t > 0.0f) {
        float s = sqrtf(t + 1.0f);
        q.w = 0.5f * s;
        s = 0.5f / s;
        q.x = (R(2,1) - R(1,2)) * s;
        q.y = (R(0,2) - R(2,0)) * s;
        q.z = (R(1,0) - R(0,1)) * s;
    } else if (R(0,0) > R(1,1) && R(0,0) > R(2,2)) {
        float s = sqrtf(1.0f + R(0,0) - R(1,1) - R(2,2));
        q.x = 0.5f * s;
        s = 0.5f / s;
        q.y = (R(1,0) + R(0,1)) * s;
        q.z = (R(0,2) + R(2,0)) * s;
        q.w = (R(2,1) - R(1,2)) * s;
    } else if (R(1,1) > R(2,2)) {
        float s = sqrtf(1.0f + R(1,1) - R(0,0) - R(2,2));
        q.y = 0.5f * s;
        s = 0.5f / s;
        q.x = (R(1,0) + R(0,1)) * s;
        q.z = (R(2,1) + R(1,2)) * s;
        q.w = (R(0,2) - R(2,0)) * s;
    } else {
        float s = sqrtf(1.0f + R(2,2) - R(0,0) - R(1,1));
        q.z = 0.5f * s;
        s = 0.5f / s;
        q.x = (R(0,2) + R(2,0)) * s;
        q.y = (R(2,1) + R(1,2)) * s;
        q.w = (R(1,0) - R(0,1)) * s;
    }
    return q;
}

// Pure-quaternion relative transform (broad phase only, no matrix materialized):
//   tw  = link_T + rotate(q_link, T_rob) - T_obs
//   T   = rotate(conj(q_obs), tw)                == R_obs^T * tw
//   qB  = conj(q_obs) * q_link * q_rob           (B == R_obs^T * R_link * R_rob)
__host__ __device__ __forceinline__ void computeRelTransformQuat(const Quat& q_obs, const Eigen::Vector3f& T_obs,
                                                                 const Quat& q_rob, const Eigen::Vector3f& T_rob,
                                                                 const Quat& q_link, const Eigen::Vector3f& link_T,
                                                                 Quat& qB, Eigen::Vector3f& T) {
    const Quat qw = quatMul(q_link, q_rob);
    const Quat qoc = quatConj(q_obs);
    const Eigen::Vector3f tw = link_T + quatRotateVec(q_link, T_rob) - T_obs;
    qB = quatMul(qoc, qw);
    T = quatRotateVec(qoc, tw);
}

// 15 OBB separating-axis tests with B entries evaluated directly from the
// quaternion components (no matrix materialized). Same eps folding as
// obbOverlapAbs. Entry formulas mirror quatToMatrix:
//   B00 = 1-2(yy+zz)  B01 = 2(xy-wz)  B02 = 2(xz+wy)
//   B10 = 2(xy+wz)    B11 = 1-2(xx+zz) B12 = 2(yz-wx)
//   B20 = 2(xz-wy)    B21 = 2(yz+wx)  B22 = 1-2(xx+yy)
__host__ __device__ __forceinline__ bool obbOverlapQuat(const Quat& q, const Eigen::Vector3f& T,
                                                        const Eigen::Vector3f& a, const Eigen::Vector3f& b,
                                                        const float eps) {
    const float qx = q.x, qy = q.y, qz = q.z, qw = q.w;
    const float xx = qx*qx, yy = qy*qy, zz = qz*qz;
    const float xy = qx*qy, xz = qx*qz, yz = qy*qz;
    const float wx = qw*qx, wy = qw*qy, wz = qw*qz;
    const float B00 = 1.0f - 2.0f*(yy + zz);
    const float B01 = 2.0f*(xy - wz);
    const float B02 = 2.0f*(xz + wy);
    const float B10 = 2.0f*(xy + wz);
    const float B11 = 1.0f - 2.0f*(xx + zz);
    const float B12 = 2.0f*(yz - wx);
    const float B20 = 2.0f*(xz - wy);
    const float B21 = 2.0f*(yz + wx);
    const float B22 = 1.0f - 2.0f*(xx + yy);

    const float aS = a[0] + a[1] + a[2];
    const float bS = b[0] + b[1] + b[2];
    const float ebs = eps * bS;
    const float eas = eps * aS;
    const float S = ebs + eas;
    const float a0e = a[0] + ebs;
    const float a1e = a[1] + ebs;
    const float a2e = a[2] + ebs;
    const float b0e = b[0] + eas;
    const float b1e = b[1] + eas;
    const float b2e = b[2] + eas;

    float t;

    t = fabsf(T[0]);
    if (t > (fabsf(B00)*b[0] + fabsf(B01)*b[1] + fabsf(B02)*b[2] + a0e)) return false;

    t = fabsf(B00*T[0] + B10*T[1] + B20*T[2]);
    if (t > (fabsf(B00)*a[0] + fabsf(B10)*a[1] + fabsf(B20)*a[2] + b0e)) return false;

    t = fabsf(T[1]);
    if (t > (fabsf(B10)*b[0] + fabsf(B11)*b[1] + fabsf(B12)*b[2] + a1e)) return false;

    t = fabsf(T[2]);
    if (t > (fabsf(B20)*b[0] + fabsf(B21)*b[1] + fabsf(B22)*b[2] + a2e)) return false;

    t = fabsf(B01*T[0] + B11*T[1] + B21*T[2]);
    if (t > (fabsf(B01)*a[0] + fabsf(B11)*a[1] + fabsf(B21)*a[2] + b1e)) return false;

    t = fabsf(B02*T[0] + B12*T[1] + B22*T[2]);
    if (t > (fabsf(B02)*a[0] + fabsf(B12)*a[1] + fabsf(B22)*a[2] + b2e)) return false;

    t = fabsf(T[2] * B10 - T[1] * B20);
    if (t > (fabsf(B20)*a[1] + fabsf(B10)*a[2] +
             fabsf(B02)*b[1] + fabsf(B01)*b[2] +
             (S - eps*(a[0] + b[0])))) return false;

    t = fabsf(T[2] * B11 - T[1] * B21);
    if (t > (fabsf(B21)*a[1] + fabsf(B11)*a[2] +
             fabsf(B02)*b[0] + fabsf(B00)*b[2] +
             (S - eps*(a[0] + b[1])))) return false;

    t = fabsf(T[2] * B12 - T[1] * B22);
    if (t > (fabsf(B22)*a[1] + fabsf(B12)*a[2] +
             fabsf(B01)*b[0] + fabsf(B00)*b[1] +
             (S - eps*(a[0] + b[2])))) return false;

    t = fabsf(T[0] * B20 - T[2] * B00);
    if (t > (fabsf(B20)*a[0] + fabsf(B00)*a[2] +
             fabsf(B12)*b[1] + fabsf(B11)*b[2] +
             (S - eps*(a[1] + b[0])))) return false;

    t = fabsf(T[0] * B21 - T[2] * B01);
    if (t > (fabsf(B21)*a[0] + fabsf(B01)*a[2] +
             fabsf(B12)*b[0] + fabsf(B10)*b[2] +
             (S - eps*(a[1] + b[1])))) return false;

    t = fabsf(T[0] * B22 - T[2] * B02);
    if (t > (fabsf(B22)*a[0] + fabsf(B02)*a[2] +
             fabsf(B11)*b[0] + fabsf(B10)*b[1] +
             (S - eps*(a[1] + b[2])))) return false;

    t = fabsf(T[1] * B00 - T[0] * B10);
    if (t > (fabsf(B10)*a[0] + fabsf(B00)*a[1] +
             fabsf(B22)*b[1] + fabsf(B21)*b[2] +
             (S - eps*(a[2] + b[0])))) return false;

    t = fabsf(T[1] * B01 - T[0] * B11);
    if (t > (fabsf(B11)*a[0] + fabsf(B01)*a[1] +
             fabsf(B22)*b[0] + fabsf(B20)*b[2] +
             (S - eps*(a[2] + b[1])))) return false;

    t = fabsf(T[1] * B02 - T[0] * B12);
    if (t > (fabsf(B12)*a[0] + fabsf(B02)*a[1] +
             fabsf(B21)*b[0] + fabsf(B20)*b[1] +
             (S - eps*(a[2] + b[2])))) return false;

    return true;
}


// Builds the 4-ary BVH. Templated on the child-index type: int16_t is the
// default (used by the rigid d_bvh_naive path); use int32_t for scenes with
// more than 32767 nodes (required by the articulated d_bvh_articulated path).
template <typename ChildT = int16_t>
BVNode_soa<ChildT> BVH_n_ary_hierarchy_from_mesh(const char* mesh_path, size_t power_of_2 = 2);

// Legacy FCL-based builder (eigen-fitted leaf OBBs), kept for comparison.
BVNode_soa<> BVH_fcl_hierarchy_from_mesh(const char* mesh_path, size_t power_of_2 = 2);

// Runs the 15 OBB separating-axis tests. Returns true when the two boxes
// overlap, false when a separating axis proves them disjoint.
__device__ __forceinline__ bool obbOverlap(const Eigen::Vector3f& a, const Eigen::Vector3f& b,
                                           const Eigen::Matrix3f& B, const Eigen::Matrix3f& Bf,
                                           const Eigen::Vector3f& T) {
    float t;

    t = fabsf(T[0]);
    if (t > (a[0] + Bf.row(0).dot(b))) return false;

    t = fabsf(B.col(0).dot(T));
    if (t > (b[0] + Bf.col(0).dot(a))) return false;

    t = fabsf(T[1]);
    if (t > (a[1] + Bf.row(1).dot(b))) return false;

    t = fabsf(T[2]);
    if (t > (a[2] + Bf.row(2).dot(b))) return false;

    t = fabsf(B.col(1).dot(T));
    if (t > (b[1] + Bf.col(1).dot(a))) return false;

    t = fabsf(B.col(2).dot(T));
    if (t > (b[2] + Bf.col(2).dot(a))) return false;

    t = fabsf(T[2] * B(1, 0) - T[1] * B(2, 0));
    if (t > (a[1] * Bf(2, 0) + a[2] * Bf(1, 0) +
             b[1] * Bf(0, 2) + b[2] * Bf(0, 1))) return false;

    t = fabsf(T[2] * B(1, 1) - T[1] * B(2, 1));
    if (t > (a[1] * Bf(2, 1) + a[2] * Bf(1, 1) +
             b[0] * Bf(0, 2) + b[2] * Bf(0, 0))) return false;

    t = fabsf(T[2] * B(1, 2) - T[1] * B(2, 2));
    if (t > (a[1] * Bf(2, 2) + a[2] * Bf(1, 2) +
             b[0] * Bf(0, 1) + b[1] * Bf(0, 0))) return false;

    t = fabsf(T[0] * B(2, 0) - T[2] * B(0, 0));
    if (t > (a[0] * Bf(2, 0) + a[2] * Bf(0, 0) +
             b[1] * Bf(1, 2) + b[2] * Bf(1, 1))) return false;

    t = fabsf(T[0] * B(2, 1) - T[2] * B(0, 1));
    if (t > (a[0] * Bf(2, 1) + a[2] * Bf(0, 1) +
             b[0] * Bf(1, 2) + b[2] * Bf(1, 0))) return false;

    t = fabsf(T[0] * B(2, 2) - T[2] * B(0, 2));
    if (t > (a[0] * Bf(2, 2) + a[2] * Bf(0, 2) +
             b[0] * Bf(1, 1) + b[1] * Bf(1, 0))) return false;

    t = fabsf(T[1] * B(0, 0) - T[0] * B(1, 0));
    if (t > (a[0] * Bf(1, 0) + a[1] * Bf(0, 0) +
             b[1] * Bf(2, 2) + b[2] * Bf(2, 1))) return false;

    t = fabsf(T[1] * B(0, 1) - T[0] * B(1, 1));
    if (t > (a[0] * Bf(1, 1) + a[1] * Bf(0, 1) +
             b[0] * Bf(2, 2) + b[2] * Bf(2, 0))) return false;

    t = fabsf(T[1] * B(0, 2) - T[0] * B(1, 2));
    if (t > (a[0] * Bf(1, 2) + a[1] * Bf(0, 2) +
             b[0] * Bf(2, 1) + b[1] * Bf(2, 0))) return false;

    return true;
}

// Computes the relative transform of the robot OBB (A) with respect to the
// obstacle OBB (B) for one robot configuration, as plain scalar math fused
// with the |R|+epsilon pre-pass. Avoids the temporaries of the equivalent
// Eigen expression tree in the per-node hot path.
__device__ __forceinline__ void computeRelTransform(const Eigen::Matrix3f& R_obs, const Eigen::Vector3f& T_obs,
                                                    const Eigen::Matrix3f& R_rob, const Eigen::Vector3f& T_rob,
                                                    const Eigen::Matrix3f& R_conf, const Eigen::Vector3f& T_conf,
                                                    const float epsilon,
                                                    Eigen::Matrix3f& B, Eigen::Matrix3f& Bf, Eigen::Vector3f& T) {    // C = R_conf * R_rob
    const float c00 = R_conf(0,0)*R_rob(0,0) + R_conf(0,1)*R_rob(1,0) + R_conf(0,2)*R_rob(2,0);
    const float c01 = R_conf(0,0)*R_rob(0,1) + R_conf(0,1)*R_rob(1,1) + R_conf(0,2)*R_rob(2,1);
    const float c02 = R_conf(0,0)*R_rob(0,2) + R_conf(0,1)*R_rob(1,2) + R_conf(0,2)*R_rob(2,2);
    const float c10 = R_conf(1,0)*R_rob(0,0) + R_conf(1,1)*R_rob(1,0) + R_conf(1,2)*R_rob(2,0);
    const float c11 = R_conf(1,0)*R_rob(0,1) + R_conf(1,1)*R_rob(1,1) + R_conf(1,2)*R_rob(2,1);
    const float c12 = R_conf(1,0)*R_rob(0,2) + R_conf(1,1)*R_rob(1,2) + R_conf(1,2)*R_rob(2,2);
    const float c20 = R_conf(2,0)*R_rob(0,0) + R_conf(2,1)*R_rob(1,0) + R_conf(2,2)*R_rob(2,0);
    const float c21 = R_conf(2,0)*R_rob(0,1) + R_conf(2,1)*R_rob(1,1) + R_conf(2,2)*R_rob(2,1);
    const float c22 = R_conf(2,0)*R_rob(0,2) + R_conf(2,1)*R_rob(1,2) + R_conf(2,2)*R_rob(2,2);

    // B = R_obs^T * C
    const float b00 = R_obs(0,0)*c00 + R_obs(1,0)*c10 + R_obs(2,0)*c20;
    const float b01 = R_obs(0,0)*c01 + R_obs(1,0)*c11 + R_obs(2,0)*c21;
    const float b02 = R_obs(0,0)*c02 + R_obs(1,0)*c12 + R_obs(2,0)*c22;
    const float b10 = R_obs(0,1)*c00 + R_obs(1,1)*c10 + R_obs(2,1)*c20;
    const float b11 = R_obs(0,1)*c01 + R_obs(1,1)*c11 + R_obs(2,1)*c21;
    const float b12 = R_obs(0,1)*c02 + R_obs(1,1)*c12 + R_obs(2,1)*c22;
    const float b20 = R_obs(0,2)*c00 + R_obs(1,2)*c10 + R_obs(2,2)*c20;
    const float b21 = R_obs(0,2)*c01 + R_obs(1,2)*c11 + R_obs(2,2)*c21;
    const float b22 = R_obs(0,2)*c02 + R_obs(1,2)*c12 + R_obs(2,2)*c22;

    B(0,0) = b00; B(0,1) = b01; B(0,2) = b02;
    B(1,0) = b10; B(1,1) = b11; B(1,2) = b12;
    B(2,0) = b20; B(2,1) = b21; B(2,2) = b22;

    Bf(0,0) = fabsf(b00) + epsilon; Bf(0,1) = fabsf(b01) + epsilon; Bf(0,2) = fabsf(b02) + epsilon;
    Bf(1,0) = fabsf(b10) + epsilon; Bf(1,1) = fabsf(b11) + epsilon; Bf(1,2) = fabsf(b12) + epsilon;
    Bf(2,0) = fabsf(b20) + epsilon; Bf(2,1) = fabsf(b21) + epsilon; Bf(2,2) = fabsf(b22) + epsilon;

    // T_world = T_conf + R_conf * T_rob - T_obs
    const float tw0 = T_conf(0) + R_conf(0,0)*T_rob(0) + R_conf(0,1)*T_rob(1) + R_conf(0,2)*T_rob(2) - T_obs(0);
    const float tw1 = T_conf(1) + R_conf(1,0)*T_rob(0) + R_conf(1,1)*T_rob(1) + R_conf(1,2)*T_rob(2) - T_obs(1);
    const float tw2 = T_conf(2) + R_conf(2,0)*T_rob(0) + R_conf(2,1)*T_rob(1) + R_conf(2,2)*T_rob(2) - T_obs(2);

    // T = T_world^T * R_obs
    T(0) = tw0*R_obs(0,0) + tw1*R_obs(1,0) + tw2*R_obs(2,0);
    T(1) = tw0*R_obs(0,1) + tw1*R_obs(1,1) + tw2*R_obs(2,1);
    T(2) = tw0*R_obs(0,2) + tw1*R_obs(1,2) + tw2*R_obs(2,2);
}

// ---------------------------------------------------------------------------
// Register-pressure-optimized narrow phase for the articulated kernel:
// the |B|+epsilon matrix is NOT materialized. Instead obbOverlapAbs folds
// |B| into the FMA source operands (free |x| modifiers in SASS) and epsilon
// into the right-hand-side sums, keeping 9 fewer floats live per node pair.
// ---------------------------------------------------------------------------
__device__ __forceinline__ void computeRelTransformNoBf(const Eigen::Matrix3f& R_obs, const Eigen::Vector3f& T_obs,
                                                        const Eigen::Matrix3f& R_rob, const Eigen::Vector3f& T_rob,
                                                        const Eigen::Matrix3f& R_conf, const Eigen::Vector3f& T_conf,
                                                        Eigen::Matrix3f& B, Eigen::Vector3f& T) {
    // C = R_conf * R_rob
    const float c00 = R_conf(0,0)*R_rob(0,0) + R_conf(0,1)*R_rob(1,0) + R_conf(0,2)*R_rob(2,0);
    const float c01 = R_conf(0,0)*R_rob(0,1) + R_conf(0,1)*R_rob(1,1) + R_conf(0,2)*R_rob(2,1);
    const float c02 = R_conf(0,0)*R_rob(0,2) + R_conf(0,1)*R_rob(1,2) + R_conf(0,2)*R_rob(2,2);
    const float c10 = R_conf(1,0)*R_rob(0,0) + R_conf(1,1)*R_rob(1,0) + R_conf(1,2)*R_rob(2,0);
    const float c11 = R_conf(1,0)*R_rob(0,1) + R_conf(1,1)*R_rob(1,1) + R_conf(1,2)*R_rob(2,1);
    const float c12 = R_conf(1,0)*R_rob(0,2) + R_conf(1,1)*R_rob(1,2) + R_conf(1,2)*R_rob(2,2);
    const float c20 = R_conf(2,0)*R_rob(0,0) + R_conf(2,1)*R_rob(1,0) + R_conf(2,2)*R_rob(2,0);
    const float c21 = R_conf(2,0)*R_rob(0,1) + R_conf(2,1)*R_rob(1,1) + R_conf(2,2)*R_rob(2,1);
    const float c22 = R_conf(2,0)*R_rob(0,2) + R_conf(2,1)*R_rob(1,2) + R_conf(2,2)*R_rob(2,2);

    // B = R_obs^T * C
    const float b00 = R_obs(0,0)*c00 + R_obs(1,0)*c10 + R_obs(2,0)*c20;
    const float b01 = R_obs(0,0)*c01 + R_obs(1,0)*c11 + R_obs(2,0)*c21;
    const float b02 = R_obs(0,0)*c02 + R_obs(1,0)*c12 + R_obs(2,0)*c22;
    const float b10 = R_obs(0,1)*c00 + R_obs(1,1)*c10 + R_obs(2,1)*c20;
    const float b11 = R_obs(0,1)*c01 + R_obs(1,1)*c11 + R_obs(2,1)*c21;
    const float b12 = R_obs(0,1)*c02 + R_obs(1,1)*c12 + R_obs(2,1)*c22;
    const float b20 = R_obs(0,2)*c00 + R_obs(1,2)*c10 + R_obs(2,2)*c20;
    const float b21 = R_obs(0,2)*c01 + R_obs(1,2)*c11 + R_obs(2,2)*c21;
    const float b22 = R_obs(0,2)*c02 + R_obs(1,2)*c12 + R_obs(2,2)*c22;

    B(0,0) = b00; B(0,1) = b01; B(0,2) = b02;
    B(1,0) = b10; B(1,1) = b11; B(1,2) = b12;
    B(2,0) = b20; B(2,1) = b21; B(2,2) = b22;

    // T_world = T_conf + R_conf * T_rob - T_obs
    const float tw0 = T_conf(0) + R_conf(0,0)*T_rob(0) + R_conf(0,1)*T_rob(1) + R_conf(0,2)*T_rob(2) - T_obs(0);
    const float tw1 = T_conf(1) + R_conf(1,0)*T_rob(0) + R_conf(1,1)*T_rob(1) + R_conf(1,2)*T_rob(2) - T_obs(1);
    const float tw2 = T_conf(2) + R_conf(2,0)*T_rob(0) + R_conf(2,1)*T_rob(1) + R_conf(2,2)*T_rob(2) - T_obs(2);

    // T = T_world^T * R_obs
    T(0) = tw0*R_obs(0,0) + tw1*R_obs(1,0) + tw2*R_obs(2,0);
    T(1) = tw0*R_obs(0,1) + tw1*R_obs(1,1) + tw2*R_obs(2,1);
    T(2) = tw0*R_obs(0,2) + tw1*R_obs(1,2) + tw2*R_obs(2,2);
}

// 15 OBB separating-axis tests, equivalent to obbOverlap(a, b, B, |B|+eps, T)
// but with |B| folded into the FMA sources and eps folded into the sums.
__device__ __forceinline__ bool obbOverlapAbs(const Eigen::Vector3f& a, const Eigen::Vector3f& b,
                                              const Eigen::Matrix3f& B, const float eps,
                                              const Eigen::Vector3f& T) {
    const float aS = a[0] + a[1] + a[2];
    const float bS = b[0] + b[1] + b[2];
    const float ebs = eps * bS;
    const float eas = eps * aS;
    const float S = ebs + eas;
    const float a0e = a[0] + ebs;
    const float a1e = a[1] + ebs;
    const float a2e = a[2] + ebs;
    const float b0e = b[0] + eas;
    const float b1e = b[1] + eas;
    const float b2e = b[2] + eas;

    float t;

    t = fabsf(T[0]);
    if (t > (fabsf(B(0,0))*b[0] + fabsf(B(0,1))*b[1] + fabsf(B(0,2))*b[2] + a0e)) return false;

    t = fabsf(B(0,0)*T[0] + B(1,0)*T[1] + B(2,0)*T[2]);
    if (t > (fabsf(B(0,0))*a[0] + fabsf(B(1,0))*a[1] + fabsf(B(2,0))*a[2] + b0e)) return false;

    t = fabsf(T[1]);
    if (t > (fabsf(B(1,0))*b[0] + fabsf(B(1,1))*b[1] + fabsf(B(1,2))*b[2] + a1e)) return false;

    t = fabsf(T[2]);
    if (t > (fabsf(B(2,0))*b[0] + fabsf(B(2,1))*b[1] + fabsf(B(2,2))*b[2] + a2e)) return false;

    t = fabsf(B(0,1)*T[0] + B(1,1)*T[1] + B(2,1)*T[2]);
    if (t > (fabsf(B(0,1))*a[0] + fabsf(B(1,1))*a[1] + fabsf(B(2,1))*a[2] + b1e)) return false;

    t = fabsf(B(0,2)*T[0] + B(1,2)*T[1] + B(2,2)*T[2]);
    if (t > (fabsf(B(0,2))*a[0] + fabsf(B(1,2))*a[1] + fabsf(B(2,2))*a[2] + b2e)) return false;

    t = fabsf(T[2] * B(1, 0) - T[1] * B(2, 0));
    if (t > (fabsf(B(2,0))*a[1] + fabsf(B(1,0))*a[2] +
             fabsf(B(0,2))*b[1] + fabsf(B(0,1))*b[2] +
             (S - eps*(a[0] + b[0])))) return false;

    t = fabsf(T[2] * B(1, 1) - T[1] * B(2, 1));
    if (t > (fabsf(B(2,1))*a[1] + fabsf(B(1,1))*a[2] +
             fabsf(B(0,2))*b[0] + fabsf(B(0,0))*b[2] +
             (S - eps*(a[0] + b[1])))) return false;

    t = fabsf(T[2] * B(1, 2) - T[1] * B(2, 2));
    if (t > (fabsf(B(2,2))*a[1] + fabsf(B(1,2))*a[2] +
             fabsf(B(0,1))*b[0] + fabsf(B(0,0))*b[1] +
             (S - eps*(a[0] + b[2])))) return false;

    t = fabsf(T[0] * B(2, 0) - T[2] * B(0, 0));
    if (t > (fabsf(B(2,0))*a[0] + fabsf(B(0,0))*a[2] +
             fabsf(B(1,2))*b[1] + fabsf(B(1,1))*b[2] +
             (S - eps*(a[1] + b[0])))) return false;

    t = fabsf(T[0] * B(2, 1) - T[2] * B(0, 1));
    if (t > (fabsf(B(2,1))*a[0] + fabsf(B(0,1))*a[2] +
             fabsf(B(1,2))*b[0] + fabsf(B(1,0))*b[2] +
             (S - eps*(a[1] + b[1])))) return false;

    t = fabsf(T[0] * B(2, 2) - T[2] * B(0, 2));
    if (t > (fabsf(B(2,2))*a[0] + fabsf(B(0,2))*a[2] +
             fabsf(B(1,1))*b[0] + fabsf(B(1,0))*b[1] +
             (S - eps*(a[1] + b[2])))) return false;

    t = fabsf(T[1] * B(0, 0) - T[0] * B(1, 0));
    if (t > (fabsf(B(1,0))*a[0] + fabsf(B(0,0))*a[1] +
             fabsf(B(2,2))*b[1] + fabsf(B(2,1))*b[2] +
             (S - eps*(a[2] + b[0])))) return false;

    t = fabsf(T[1] * B(0, 1) - T[0] * B(1, 1));
    if (t > (fabsf(B(1,1))*a[0] + fabsf(B(0,1))*a[1] +
             fabsf(B(2,2))*b[0] + fabsf(B(2,0))*b[2] +
             (S - eps*(a[2] + b[1])))) return false;

    t = fabsf(T[1] * B(0, 2) - T[0] * B(1, 2));
    if (t > (fabsf(B(1,2))*a[0] + fabsf(B(0,2))*a[1] +
             fabsf(B(2,1))*b[0] + fabsf(B(2,0))*b[1] +
             (S - eps*(a[2] + b[2])))) return false;

    return true;
}

// SoA parameter bundles for d_bvh_naive: one struct per side (obstacle /
// robot) plus the result/queue/profiling counters. Struct params keep the
// kernel call readable; they are copied into the kernel parameter space
// exactly like the equivalent flat parameter list, so this costs nothing.
struct RigidObstacleSoA {
    const Eigen::Matrix3f* __restrict__ R;      // matrix storage (legacy)
    const float4* __restrict__ Rq;              // quaternion storage (quatSAT)
    const Eigen::Vector3f* __restrict__ T;
    const Eigen::Vector3f* __restrict__ dim;
    const int16_t* __restrict__ first_child;
    const float* __restrict__ a;
    const Eigen::Vector3f* __restrict__ verts;
    const Triangle* __restrict__ tris;
    size_t num_nodes;
};

struct RigidRobotSoA {
    const Eigen::Matrix3f* __restrict__ R;      // matrix storage (legacy)
    const float4* __restrict__ Rq;              // quaternion storage (quatSAT)
    const Eigen::Vector3f* __restrict__ T;
    const Eigen::Vector3f* __restrict__ dim;
    const int16_t* __restrict__ first_child;
    const float* __restrict__ a;
    const Eigen::Vector3f* __restrict__ verts;
    const Triangle* __restrict__ tris;
    size_t num_nodes;
    const Eigen::Matrix3f* __restrict__ conf_rot;    // per-config rigid transforms
    const Eigen::Vector3f* __restrict__ conf_trans;
};

struct RigidKernelOut {
    uint32_t* __restrict__ pdisjoint;
    uint32_t* __restrict__ g_next_conf;
    unsigned long long* __restrict__ d_phase;
};

__global__ void d_bvh_naive(const RigidObstacleSoA obs, const RigidRobotSoA rob,
                            size_t num_confs, const RigidKernelOut out);

// Checks the given configurations for collisions against the obstacle.
// Returns one entry per configuration: true if the configuration is valid (no collision).
double bvh_naive(const BVNode_soa<>& rob_BVH, const BVNode_soa<>& obs_BVH,
                 const MeshData& rob_mesh, const MeshData& obs_mesh,
                 const std::vector<Configuration>& confs,
                 std::vector<bool>& valid, bool dry_run = false);