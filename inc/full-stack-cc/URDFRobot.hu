#pragma once
#include "ArticulatedRobot.hu"

// Maximum number of links supported by d_bvh_urdf. The kernel stores one
// transform per link in local memory, so this bound keeps local usage sane.
#define URDF_MAX_LINKS 64

// Host-side description of a fully general (branching) robot tree parsed from
// a URDF file. Link transforms are recovered from per-link parent pointers and
// a topological ordering, so arbitrary branching is supported.
struct URDFRobot {
    int num_links = 0;
    int num_joints = 0; // number of movable (revolute/continuous) joints

    std::vector<std::string> link_names;   // size num_links
    std::vector<std::string> link_meshes;  // size num_links (empty if no collision mesh)

    std::vector<int> link_parent;          // size num_links, -1 for the root
    std::vector<JointParams> joint_origin; // size num_links, fixed origin of the joint above each link
    std::vector<Eigen::Vector3f> joint_axis; // size num_links
    std::vector<int> joint_angle_idx;      // size num_links, index into conf or -1 for root/fixed

    std::vector<int> link_order;           // topological order (root first), size num_links
    std::vector<std::string> joint_names;  // size num_joints, movable joints in conf order
};

// Parses a full URDF file into a general kinematic tree (branching allowed).
// Revolute/continuous joints become movable angle joints; fixed and other
// joint types are treated as rigid (angle always 0). Returns false on failure.
bool parseFullURDF(const std::string& urdf_path, URDFRobot& robot);

// d_bvh_urdf: full-URDF version of d_bvh_naive. Each thread checks one
// configuration by computing forward kinematics over the whole tree and
// colliding every link's BVH against the obstacle BVH.
template <size_t N>
__global__ void d_bvh_urdf(const Eigen::Matrix3f* pR_obs, const Eigen::Vector3f* pT_obs,
                           const Eigen::Vector3f* pObs_dim, const int32_t* pObs_first_child,
                           size_t num_obs_nodes,
                           const Eigen::Vector3f* pObs_verts, const Triangle* pObs_tris,
                           const Eigen::Matrix3f* pRob_R, const Eigen::Vector3f* pRob_T,
                           const Eigen::Vector3f* pRob_dim, const int32_t* pRob_first_child,
                           const Eigen::Vector3f* pRob_verts, const Triangle* pRob_tris,
                           const int* pLinkOffset, const int* pLinkVertOffset, const int* pLinkTriOffset,
                           int num_links,
                           const int* pLinkParent, const int* pLinkOrder,
                           const JointParams* pJointOrigin, const Eigen::Vector3f* pJointAxis,
                           const int* pJointAngleIdx,
                           const articulated_conf<N>* pConf, size_t num_confs,
                           bool* pdisjoint,
                           unsigned long long* overflowCounter);

// Host wrapper mirroring bvh_articulated but for a full (branching) URDF tree.
template <size_t N>
double bvh_urdf(const std::string& robot_urdf_path,
                const BVNode_soa<int32_t>& obs_BVH, const MeshData& obs_mesh,
                const std::vector<articulated_conf<N>>& confs,
                std::vector<bool>& valid, bool dry_run = false);

#include "URDFRobot.tcc"
